NODE_ENV=development
PORT=8080

# Set to "true" locally to read secrets from env vars below instead of GCP Secret Manager
USE_LOCAL_SECRETS=true
GCP_PROJECT_ID=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/salesmore_llm

ANTHROPIC_API_KEY=
JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Soft monthly cost cap for the pilot. Empty = no limit.
MONTHLY_BUDGET_USD=

# Used only by the admin dashboard's enterprise-vs-our-tool comparison.
ENTERPRISE_SEAT_COST_USD=
ENTERPRISE_SEATS=

# Model IDs used for chat vs. the cheap quality-judge model
CHAT_MODEL=claude-sonnet-5
JUDGE_MODEL=claude-haiku-4-5-20251001

# Pre-check / sensitive-data hard-block, runs before every message reaches
# the Anthropic API. Set to "false" to disable (not recommended in the pilot).
PRECHECK_ENABLED=true
PRECHECK_MODEL=claude-haiku-4-5-20251001
