NODE_ENV=development
PORT=8080

# Set to "true" locally to read secrets from env vars below instead of GCP Secret Manager
USE_LOCAL_SECRETS=true
GCP_PROJECT_ID=

# BigQuery access for the query_bigquery LLM tool. Auth is via ADC or
# GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account key file scoped
# to read-only access on ONE dataset (do not use a project-wide/admin key).
# BIGQUERY_ALLOWED_TABLES is a comma-separated "dataset.table" allowlist
# (e.g. "analytics.campaign_summary,analytics.sales_agg"). Empty = the tool
# refuses every query (fail closed). Only add tables/views that have been
# reviewed and don't expose raw PII — prefer aggregated/masked views over
# source tables. Check GET /metrics/bigquery-status (admin/manager only) to
# verify the connection once GCP_PROJECT_ID and credentials are set.
BIGQUERY_ALLOWED_TABLES=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_db

# Non-superuser role the backend should actually connect as, so the
# conversations_isolation/messages_isolation RLS policies (migrations
# 025-027) are enforced. Falls back to DATABASE_URL (superuser, bypasses RLS)
# when unset -- fine for local dev, must be set in production.
APP_DATABASE_URL=

# Conversation retention cleanup (backend/src/services/retention). Disabled
# by default since it's a destructive, unbounded-scope deletion; set to
# "true" to enable the daily job and let POST /metrics/retention/run
# actually delete instead of dry-running.
DATA_RETENTION_ENABLED=false
DATA_RETENTION_DAYS=365

# Local Ollama server (https://ollama.com) — install it, then
# `ollama pull llama3.1` before starting the backend. No API key: it's a
# model running on this machine (or wherever OLLAMA_BASE_URL points).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google Workspace OAuth ("Sign in with Google" — only lets already-provisioned
# users in, no self-signup). Create an OAuth client in Google Cloud Console
# with GOOGLE_OAUTH_REDIRECT_URL as an authorized redirect URI
# (e.g. http://localhost:8080/auth/google/callback in dev).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Optional: restrict Google OAuth self-provisioning to one email domain
# (e.g. "example.com"). Leave empty to allow any domain to self-provision.
ALLOWED_EMAIL_DOMAIN=

# Soft monthly cost caps for the pilot. Empty = no limit.
# Org-wide total across all users:
MONTHLY_BUDGET_USD=
# Per-user cap, protects the org budget from a single heavy user:
MONTHLY_BUDGET_PER_USER_USD=

# Used only by the admin dashboard's enterprise-vs-our-tool comparison.
ENTERPRISE_SEAT_COST_USD=
ENTERPRISE_SEATS=

# Pre-check / sensitive-data hard-block, runs before every message reaches
# the model. Set to "false" to disable (not recommended in the pilot).
# Defaults to OLLAMA_MODEL above when unset — set this separately only if
# you're running more than one local model and want a different (e.g.
# smaller/faster) one just for classification.
PRECHECK_ENABLED=true
PRECHECK_MODEL=

# Standalone document gate (backend/scripts/check-document.mjs,
# POST /document-gateway) — checks a file before it goes to any LLM, not
# just this chat. Reuses PRECHECK_MODEL/PRECHECK_PROMPT for classification.
# Documents longer than this are truncated before classification and the
# result is marked truncated:true, so a partial check is never mistaken for
# a full one.
DOCUMENT_GATEWAY_MAX_CHARS=20000

# Attachment/knowledge-file storage backend: "local" (default, disk under
# backend/uploads/ — fine for a single replica) or "gcs" (Google Cloud
# Storage — required once the backend runs with more than 1 replica, so all
# instances share the same files). When "gcs": set GCS_BUCKET_NAME and
# GCP_PROJECT_ID above, and auth via GOOGLE_APPLICATION_CREDENTIALS pointing
# at a service-account key file (or ADC on GCP itself).
STORAGE_BACKEND=local
GCS_BUCKET_NAME=

# "Contact support" form (POST /support). Messages are always saved to the
# support_messages table; email delivery is best-effort on top of that and
# silently skipped if RESEND_API_KEY is empty. Uses Resend's HTTPS API
# (https://resend.com), not SMTP -- Railway blocks outbound SMTP ports
# entirely, so a real SMTP transport never gets through from there.
# SUPPORT_NOTIFY_EMAIL is the inbox that receives them -- shown to users only
# as "support", never by name.
RESEND_API_KEY=
SUPPORT_NOTIFY_EMAIL=

# Email alert when the uncertain-leak agent (services/security/
# uncertainLeakAgent.js) flags a suspicious message -- on top of the row it
# already writes to leak_alerts either way. Falls back to
# SUPPORT_NOTIFY_EMAIL if unset; leave empty to disable the email and rely on
# GET /metrics/leak-alerts only.
LEAK_ALERT_NOTIFY_EMAIL=

# Google Ads API (read-only reporting, /kampanie-ads command). Needs a
# developer token approved for your Google Ads manager account, an OAuth2
# client + refresh token authorized against that account, and the customer
# ID (account) to report on. Leave any of these empty to disable the Google
# Ads half of the command.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Only needed if GOOGLE_ADS_CUSTOMER_ID is a child account under a manager
# (MCC) account -- set to the manager account's ID. Defaults to
# GOOGLE_ADS_CUSTOMER_ID when unset.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta (Facebook) Marketing API (read-only reporting, /kampanie-ads command).
# Needs a long-lived access token for a user/system-user with read access to
# the ad account, and the ad account ID (with or without the "act_" prefix).
# Leave either empty to disable the Meta Ads half of the command.
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
